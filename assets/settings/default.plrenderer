{    
    "format": "plrenderer", 
    "version": 1, 
    "lighting": {        
        "image_based": true, 
        "normal_mapping": true, 
        "punctual_lights": true, 
        "shadows": true, 
        "diffuse_probes": true, 
        "reflection_probes": true
    }, 
    "sky": {        
        "sky_lut_resolution": [ 200, 100 ], 
        "transmission_lut_resolution": [ 256, 256 ], 
        "multiscatter_lut_resolution": [ 64, 64 ], 
        "aerial_lut_resolution": [ 128, 128, 32 ]
    }, 
    "shadows": {        
        "max_range": 200, 
        "constant_bias": -1.25, 
        "slope_bias": -1, 
        "resolution": 4096, 
        "cascade_count": 3, 
        "contact_length": 0.3, 
        "contact_thickness": 0.05, 
        "contact_bias": 0.01, 
        "contact_steps": 16, 
        "contact_shadows": false, 
        "pcf": true, 
        "multiviewport": true
    }, 
    "fxaa": {        
        "enabled": true
    }, 
    "ambient_occlusion": {      
        "enabled": false,  
        "radius": 0.5, 
        "strength": 1, 
        "bias": 0.05, 
        "mode": "ssao"
    }, 
    "ssgi": {        
        "enabled": false,
        "strength": 1, 
        "radius": 2, 
        "thickness": 0.15, 
        "ray_count": 8, 
        "step_count": 16
    }, 
    "bloom": {        
        "radius": 1.5, 
        "strength": 0.05, 
        "chain_length": 5, 
        "enabled": true
    }, 
    "fog": {        
        "enabled": false, 
        "start": 1, 
        "cutoff_distance": 1000, 
        "color": [ 1, 1, 1 ], 
        "density": 0.1, 
        "height": 0, 
        "max_opacity": 0.1, 
        "height_falloff": 0.1, 
        "mode": "exponential"
    }, 
    "tonemap": {        
        "exposure": 1, 
        "brightness": 0, 
        "contrast": 1, 
        "saturation": 1.0, 
        "mode": "pbr_neutral"
    }
}