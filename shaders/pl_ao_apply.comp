#version 450
#extension GL_GOOGLE_include_directive : enable
#include "pl_ao.inc"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, r32f) uniform writeonly image2D target;
layout(set = 0, binding = 1) uniform texture2D aoFull;
layout(set = 0, binding = 2) uniform texture2D aoHalf;
layout(set = 0, binding = 3) uniform texture2D aoQuarter;
layout(set = 0, binding = 5) uniform sampler pointSampler;

float
filteredAO(texture2D tex, vec2 uv, vec4 center)
{
    ivec2 size = textureSize(sampler2D(tex, pointSampler), 0);
    ivec2 p = ivec2(uv * vec2(size));
    float sum = 0.0;
    float weights = 0.0;
    vec3 n = Decode(center.ba);
    for(int y = -1; y <= 1; y++)
    for(int x = -1; x <= 1; x++)
    {
        ivec2 q = p + ivec2(x, y);
        if(!aoInside(q, size))
            continue;
        vec4 s = texelFetch(sampler2D(tex, pointSampler), q, 0);
        if(s.g <= 0.0)
            continue;
        float w = exp(-abs(s.g - center.g) / max(tAO.tData.fRadius * 0.1, 0.0001));
        w *= pow(max(dot(n, Decode(s.ba)), 0.0), 16.0);
        w *= exp(-0.5 * float(x * x + y * y));
        sum += s.r * w;
        weights += w;
    }
    return weights > 0.00001 ? sum / weights : 1.0;
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if(!aoInside(p, ivec2(tAO.tData.tViewportSize)))
        return;
    vec4 center = texelFetch(sampler2D(aoFull, pointSampler), p, 0);
    if(center.g <= 0.0)
    {
        imageStore(target, p, vec4(1.0));
        return;
    }
    vec2 uv = (vec2(p) + 0.5) / tAO.tData.tViewportSize;
    float visibility = filteredAO(aoFull, uv, center);
    if(tAO.tData.iLevels == 3)
    {
        visibility = visibility * 0.5 + filteredAO(aoHalf, uv, center) * 0.3 + filteredAO(aoQuarter, uv, center) * 0.2;
    }
    visibility = pow(clamp(visibility, 0.0, 1.0), tAO.tData.fStrength);
    imageStore(target, p, vec4(visibility));
}
