#version 450
#extension GL_ARB_separate_shader_objects : enable
#define PL_VIEW_SET_LOCATION 0
#define PL_CLUSTER_WRITE
#include "pl_bg_view.inc"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Solve projection at a positive view-space depth. Works for perspective and
// orthographic cameras, either depth convention, and off-center projections.
vec3
cluster_corner(vec2 ndc, float depth)
{
    mat4 p = tViewInfo.tData.tCameraProjection[0];
    float w = p[2][3] * depth + p[3][3];
    return vec3((ndc.x * w - p[2][0] * depth - p[3][0]) / p[0][0], (ndc.y * w - p[2][1] * depth - p[3][1]) / p[1][1], depth);
}

bool
intersects(vec3 worldPosition, float radius, vec3 lo, vec3 hi)
{
    // Nonpositive range denotes an unbounded light in pl_lights.glsl.
    if(radius <= 0.0)
        return true;
    vec3 center = (tViewInfo.tData.tCameraView[0] * vec4(worldPosition, 1.0)).xyz;
    vec3 delta = center - clamp(center, lo, hi);
    float paddedRadius = radius + 0.0001 * max(1.0, radius);
    return dot(delta, delta) <= paddedRadius * paddedRadius;
}

void main()
{
    uint cluster = gl_GlobalInvocationID.x;

    if(cluster >= PL_CLUSTER_X * PL_CLUSTER_Y * PL_CLUSTER_Z)
        return;

    // find our cluster
    uint x = cluster % PL_CLUSTER_X;
    uint y = (cluster / PL_CLUSTER_X) % PL_CLUSTER_Y;
    uint z = cluster / (PL_CLUSTER_X * PL_CLUSTER_Y);

    float nearZ = tViewInfo.tData.fCameraNearZ;
    float ratio = (nearZ + tViewInfo.tData.fCameraRange) / nearZ;
    float z0 = nearZ * pow(ratio, float(z) / float(PL_CLUSTER_Z));
    float z1 = nearZ * pow(ratio, float(z + 1u) / float(PL_CLUSTER_Z));
    vec2 uv0 = vec2(x, y) / vec2(PL_CLUSTER_X, PL_CLUSTER_Y) * 2.0 - 1.0;
    vec2 uv1 = vec2(x + 1u, y + 1u) / vec2(PL_CLUSTER_X, PL_CLUSTER_Y) * 2.0 - 1.0;
    vec3 lo = vec3(1e30);
    vec3 hi = vec3(-1e30);


    for(int corner = 0; corner < 8; ++corner)
    {
        vec3 v = cluster_corner(vec2((corner & 1) == 0 ? uv0.x : uv1.x, (corner & 2) == 0 ? uv0.y : uv1.y), (corner & 4) == 0 ? z0 : z1);
        lo = min(lo, v);
        hi = max(hi, v);
    }

    // Expand for floating-point disagreement at shared cluster boundaries
    vec3 epsilon = 0.0001 * max(vec3(1.0), max(abs(lo), abs(hi)));
    lo -= epsilon;
    hi += epsilon;
    uint base = cluster * PL_CLUSTER_STRIDE;
    uint count = 0u;

    // point lights
    for(int i = 0; i < tViewInfo.tData.iClusterPointCount; ++i)
    {
        plGpuPointLight light = tPointLightInfo.atData[i];
        if(!intersects(light.tPosition, light.fRange, lo, hi))
            continue;
        if(count < PL_CLUSTER_LIGHT_CAPACITY)
            tClusterData.auData[base + 2u + count] = uint(i);
        ++count;
    }

    // spot lights
    tClusterData.auData[base] = count;
    count = 0u;
    for(int i = 0; i < tViewInfo.tData.iClusterSpotCount; ++i)
    {
        plGpuSpotLight light = tSpotLightInfo.atData[i];
        
        // Range sphere conservatively encloses the entire spot cone.
        if(!intersects(light.tPosition, light.fRange, lo, hi))
            continue;
        if(count < PL_CLUSTER_LIGHT_CAPACITY)
            tClusterData.auData[base + 2u + PL_CLUSTER_LIGHT_CAPACITY + count] = uint(i);
        ++count;
    }
    tClusterData.auData[base + 1u] = count;
}
