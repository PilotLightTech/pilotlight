#version 450
#extension GL_ARB_separate_shader_objects : enable

#include "pl_cube.inc"
#include "pl_shader_interop_renderer.h"
#include "pl_probe_common.glsl"

layout(set = 0, binding = 0) uniform sampler tDefaultSampler;
layout(set = 0, binding = 1) uniform textureCube uCubeMap;
// Packed RGBA16F texels (two halves per uint) copied straight into the SH atlas.
layout(std430, set = 1, binding = 0) buffer _tBufferOut0 { uvec2 atCoefficients[]; } tSHOut;

layout(set = 3, binding = 0) uniform PL_DYNAMIC_DATA
{
    plGpuDynFilterSpec tData;
} tDynamicData;

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
// One workgroup projects all nine coefficients: each texel is fetched once.
// Slots 0-8 hold the coefficient sums, slot 9 the total solid angle.
shared vec3 atPartial[64][10];

float
pl_sh_area(vec2 tUV)
{
    return atan(tUV.x * tUV.y, sqrt(dot(tUV, tUV) + 1.0));
}

void
main()
{
    const uint uThread = gl_LocalInvocationID.x;
    const int iWidth = tDynamicData.tData.iResolution;
    vec3 atSum[9];
    for(int c = 0; c < 9; c++)
        atSum[c] = vec3(0.0);
    float fWeightSum = 0.0;
    for(int i = int(uThread); i < 6 * iWidth * iWidth; i += 64)
    {
        int iFace = i / (iWidth * iWidth);
        ivec2 tPixel = ivec2(i % iWidth, (i / iWidth) % iWidth);
        vec2 tMin = 2.0 * vec2(tPixel) / float(iWidth) - 1.0;
        vec2 tMax = 2.0 * vec2(tPixel + 1) / float(iWidth) - 1.0;
        float fWeight = pl_sh_area(tMax) - pl_sh_area(vec2(tMin.x, tMax.y)) - pl_sh_area(vec2(tMax.x, tMin.y)) + pl_sh_area(tMin);
        vec3 n = normalize(pl_uv_to_xyz(iFace, (tMin + tMax) * 0.5));
        vec3 tRadiance = textureLod(samplerCube(uCubeMap, tDefaultSampler), n, 0.0).rgb;
        tRadiance *= fWeight;
        for(int c = 0; c < 9; c++)
            atSum[c] += tRadiance * pl_sh_basis(c, n);
        fWeightSum += fWeight;
    }
    for(int c = 0; c < 9; c++)
        atPartial[uThread][c] = atSum[c];
    atPartial[uThread][9] = vec3(fWeightSum);
    barrier();
    for(uint uStride = 32; uStride > 0; uStride >>= 1)
    {
        if(uThread < uStride)
        {
            for(int c = 0; c < 10; c++)
                atPartial[uThread][c] += atPartial[uThread + uStride][c];
        }
        barrier();
    }
    if(uThread < 9)
    {
        // Cosine convolution divided by pi: band factors 1, 2/3 and 1/4.
        const int iCoefficient = int(uThread);
        float fBand = iCoefficient == 0 ? 1.0 : (iCoefficient < 4 ? 2.0 / 3.0 : 0.25);
        vec3 tCoefficient = atPartial[0][iCoefficient] * (12.5663706144 / atPartial[0][9].x) * fBand;
        tCoefficient = clamp(tCoefficient, vec3(-65504.0), vec3(65504.0)); // stay finite in half precision
        tSHOut.atCoefficients[iCoefficient] = uvec2(packHalf2x16(tCoefficient.xy), packHalf2x16(vec2(tCoefficient.z, 0.0)));
    }
}
