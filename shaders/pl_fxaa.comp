#version 450
#extension GL_ARB_separate_shader_objects : enable

#include "pl_shader_interop_renderer.h"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D target;
layout(set = 0, binding = 1) uniform texture2D source;
layout(set = 0, binding = 2) uniform sampler tSamplerLinearClamp;
layout(set = 3, binding = 0) uniform PL_DYNAMIC_DATA
{
    plGpuDynFXAA tData;
} tDynamicData;

// Coordinates are in pixels. Clamp to the active view, since its allocation
// includes spare space for resizing which does not contain rendered pixels.
vec3
sampleColor(vec2 pixel)
{
    vec2 extent = vec2(tDynamicData.tData.iWidth, tDynamicData.tData.iHeight);
    vec2 uv = clamp(pixel, vec2(0.5), extent - 0.5) / vec2(textureSize(sampler2D(source, tSamplerLinearClamp), 0));
    return textureLod(sampler2D(source, tSamplerLinearClamp), uv, 0.0).rgb;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if(pixel.x >= tDynamicData.tData.iWidth || pixel.y >= tDynamicData.tData.iHeight)
        return;

    vec2 center = vec2(pixel) + 0.5;
    vec4 original = texelFetch(sampler2D(source, tSamplerLinearClamp), pixel, 0);
    const vec3 lumaWeights = vec3(0.299, 0.587, 0.114);
    float m  = dot(original.rgb, lumaWeights);
    float nw = dot(sampleColor(center + vec2(-1, -1)), lumaWeights);
    float ne = dot(sampleColor(center + vec2( 1, -1)), lumaWeights);
    float sw = dot(sampleColor(center + vec2(-1,  1)), lumaWeights);
    float se = dot(sampleColor(center + vec2( 1,  1)), lumaWeights);
    float lo = min(m, min(min(nw, ne), min(sw, se)));
    float hi = max(m, max(max(nw, ne), max(sw, se)));

    // Skip flat regions and low-contrast noise in display-referred color.
    if(hi - lo < max(1.0 / 32.0, hi / 8.0))
    {
        imageStore(target, pixel, original);
        return;
    }

    // FXAA's luminance gradient determines the direction along the edge.
    vec2 direction = vec2(-((nw + ne) - (sw + se)), (nw + sw) - (ne + se));
    float reduction = max((nw + ne + sw + se) * (0.25 / 8.0), 1.0 / 128.0);
    direction = clamp(direction / (min(abs(direction.x), abs(direction.y)) + reduction), vec2(-8.0), vec2(8.0));
    vec3 narrow = 0.5 * (sampleColor(center - direction / 6.0) + sampleColor(center + direction / 6.0));
    vec3 wide = narrow * 0.5 + 0.25 * (sampleColor(center - direction * 0.5) + sampleColor(center + direction * 0.5));
    float wideLuma = dot(wide, lumaWeights);
    // Reject the wider filter if it crosses beyond the local luminance range.
    imageStore(target, pixel, vec4(wideLuma < lo || wideLuma > hi ? narrow : wide, original.a));
}
